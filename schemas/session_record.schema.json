{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/session_record.schema.json",
  "title": "Market engine session JSONL record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_schema_version", "record_ordinal", "kind", "arrival_ordinal", "event_time_ns", "payload"],
  "properties": {
    "record_schema_version": {"const": "1.0.0"},
    "record_ordinal": {"type": "integer", "minimum": 0},
    "kind": {"type": "string", "minLength": 1},
    "arrival_ordinal": {"type": ["integer", "null"], "minimum": 0},
    "event_time_ns": {"type": ["integer", "null"], "minimum": 0},
    "payload": {}
  }
}
